# Base URLs of the backends (baked in at build time by Vite).
VITE_AUTH_API_URL=http://localhost:8080
VITE_RAINSAVER_API_URL=http://localhost:8081
# Reserved ad slots on the home page (empty boxes only, no ad script yet). Off by default.
# VITE_ADS_ENABLED=true
# Subscription screens backed by a browser-only fake (demo/dev). Off by default; production never sets it.
# VITE_SUBSCRIPTION_MODE=mock
# Mock only: make an action fail to test the error states (subscribe | cancel | resume).
# VITE_SUBSCRIPTION_MOCK_FAIL=subscribe

# Production (GitHub Pages): set as repository variables, not in a file.
# VITE_AUTH_API_URL=https://ca-auth.lemonmoss-8726f7e4.northcentralus.azurecontainerapps.io
# VITE_RAINSAVER_API_URL=   (rain-saver is not deployed yet)
